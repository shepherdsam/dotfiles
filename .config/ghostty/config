# Ghostty configuration
# Ported from Alacritty + managed by bin/theme for light/dark switching

# Font
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 14

# Window appearance
# window-padding-x = 4
# window-padding-y = 4
window-padding-balance = true
background-opacity = 0.95
# background-blur = true

# macOS specific
macos-titlebar-style = hidden

# Theme (managed by bin/theme script - do not edit directly)

# Hyperlink behavior with tmux:
# tmux mouse on + Ghostty shell integration means Ghostty intercepts Shift+Cmd+Click
# for hyperlinks, sending plain Cmd+Click to tmux. Use Shift+Cmd+Click inside tmux.
theme = one_dark

# Let herdr (tmux-style keybinds) receive Option+Left/Right for tab navigation.
# Ghostty defaults bind these to esc:b / esc:f (backward/forward-word), which
# swallows the real modifier-arrow chords herdr's next_tab/previous_tab expects.
keybind = alt+left=unbind
keybind = alt+right=unbind
